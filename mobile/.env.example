# The Django backend's base URL. EXPO_PUBLIC_* vars are inlined into the
# app bundle at build time (see src/api/client.ts) — never put a secret in
# one of these, only ever the API address itself.
#
# - Android emulator reaching your own machine's dev server: 10.0.2.2
# - iOS simulator reaching your own machine's dev server: localhost works
# - A physical phone (either platform): your machine's LAN IP, e.g.
#   http://192.168.1.23:8000 — find it with `ipconfig` (Windows) and make
#   sure the phone is on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
