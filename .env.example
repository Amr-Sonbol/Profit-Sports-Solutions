SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=spots
DB_USER=spots
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Leave EMAIL_BACKEND unset (or console) for local dev — emails print to
# the terminal instead of sending. Fill these in for real sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@profitsportssolutions.com

# Leave SENTRY_DSN unset for local dev — error monitoring stays off.
# Fill it in (from your Sentry project's settings) to get alerted on
# unhandled errors in production instead of only hearing about them
# from a user.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
